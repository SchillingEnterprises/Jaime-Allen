# Copy to .env for local development. Never commit the populated .env file.
DEBUG=true
# Leave blank for DEBUG=true (an ephemeral development key is generated).
# Production must provide a unique, high-entropy SECRET_KEY.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=false

# Free/local AI option: run Ollama on this machine and pull a compatible model.
# Example: ollama pull qwen2.5:3b
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional paid hosted provider. Set AI_PROVIDER=openai only when intentionally
# using an API key with its associated usage costs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Leave false unless a documented retention policy and access controls exist.
STORE_CHAT_INTERACTIONS=false
