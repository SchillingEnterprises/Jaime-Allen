# Copy to .env for local development. Never commit real values.
DEBUG=true
# Leave blank for DEBUG=true local development to use an ephemeral key.
# For persistent environments, generate a fresh key with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
AI_PROVIDER=ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
STORE_CHAT_INTERACTIONS=false

# Production example (set in the host's secret manager, not in source control):
# DEBUG=false
# SECRET_KEY=replace-with-generated-secret
# ALLOWED_HOSTS=your-domain.example
# SECURE_SSL_REDIRECT=true
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=https://your-private-ollama-host
# STORE_CHAT_INTERACTIONS=false
