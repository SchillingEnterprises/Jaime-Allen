# Copy this file to .env for local development. Never commit .env.
DEBUG=true
# With DEBUG=true, Django generates an ephemeral local key if SECRET_KEY is blank.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Configure a key only when enabling the external AI integration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SECURE_SSL_REDIRECT=false
